		'''
}

ExecutorsSwordMarkPlus: {
	DisplayName: Executioner's Sword Mark A++
	Tooltip:
		'''
		When taking damage, adds {0} Execution Progress to your currently held weapon
		After an Execution Strike, adds {0} Execution Progress to the current weapon, but clears Execution Progress from all other weapons
		If holding a Caster weapon, adds 1/{1} of the Execution Progress required to trigger Execution Strike for that weapon
		After an Execution Strike, until you manually switch weapons, gain the following effects:
		When current health is above 50%, increases executor critical strike damage by {2}%
		When current health is 100%, increases executor critical strike damage by {2}%
		'''
}

