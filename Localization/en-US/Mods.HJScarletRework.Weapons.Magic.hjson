BrimstoneHeart: {
	DisplayName: Brimstone Heart
	Tooltip:
		'''
		Halves your life regen speed and disables [ScarletBuff/Terraria/Regeneration] 
		On activation, sacrifice 150 health and inflict [ScarletDebuff/Terraria/Bleeding] on yourself, but grants an extremely long invincibility duration
		Fires swift brimstone fireballs that cause lava explosions on hit
		The lower your health, the higher the damage dealt by the lava explosions
		Shift + Right-click to toggle item mode, drawing out the heart more safely, but does not provide self-damage or invincibility effects
		'''
}

LivingBoomerangMagic: {
	DisplayName: Pruned Arcanum Living Boomerang
	Tooltip:
		'''
		On use, applies [ScarletBuff/Terraria/ManaRegeneration] to yourself
		Continuously generates petals and leaves that hunt down enemies
		Direct hits with the boomerang itself restore mana
		"A proof that another world truly existed"
		'''
}
