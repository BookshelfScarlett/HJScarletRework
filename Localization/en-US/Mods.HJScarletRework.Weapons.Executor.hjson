Exsanguination: {
	DisplayName: Exsanguination
	Tooltip:
		'''
		Fires a stream of speed bullets at extremely high speed
		All bullets fired deal true damage
		'''
	ExecutionStrike:
		'''
		Completely shatter the shield of the hit enemy
		For a period of time afterwards, deal 1.12x damage
		'''
}

MantleLayer: {
	DisplayName: Mantle Layer
	Tooltip:
		'''
		Bounces off, then performs a heavy strike on hit
		Does not trigger this effect on return
		'''
	ExecutionStrike:
		'''
		Attach to your enemy, dealing continuous damage
		Then, Perform two heavier heavy strikes
		'''
}

DungeonBreaker: {
	DisplayName: Dungeon Breaker
	Tooltip:
		'''
		Cause a shockwave that deals area damage on hit
		Directly destroys dangerous blocks within the Dungeon
		'''
	ExecutionStrike:
		'''
		Thrown at high speed and allows infinite penetration
		Forcibly knocks back all nearby small enemies upon smashes into a wall
		Continuously release small water bolts backwards that can bounce off walls
		'''
}

FleshGrinder: {
	DisplayName: Flesh Grinder
	Tooltip: Crush the target's flesh on hit
	ExecutionStrike:
		'''
		Seek out multiple enemies and attacks for 6 times
		Can attack up to 4 enemies
		'''
}

JungleMadness: {
	DisplayName: Jungle Madness
	Tooltip: Spawns briefly flying leaves that ignore walls on hit
	ExecutionStrike: Strike back and attach to enemy, release rotating leaves
}

DreamlessNight: {
	DisplayName: Dreamless Night
	Tooltip: Release dream flower on hit
	ExecutionStrike:
		'''
		Summon a minion that mimics player actions
		Persists after switching weapons, enhances Dreamless Night's normal strikes 
		Duration is consumed only when attacking
		Dashes toward the player's cursor before expiring
		Does not increase Execution Progress while present
		'''
	FlavorTooltips:
		'''
		Through that endless, lingering night,
		I ache for the presence of a dream
		'''
}

TheDefiler: {
	DisplayName: The Defiler
	Tooltip: Infected victim on hit
	ExecutionStrike:
		'''
		Seek out multiple enemies and attacks for 4 times
		Can attack up to 7 enemies
		'''
}

AetherfireSmasher: {
	DisplayName: Aetherfire Smasher
	Tooltip:
		'''
		Flies over to a neaby available enemy
		Releases seeking fireballs on hit
		'''
	ExecutionStrike:
		'''
		Aetherfire Smasher attaches to the target
		Also releases pillars of fire and seeking fireballs
		'''
}

BinaryStars: {
	DisplayName: Binary Stars
	Tooltip: On hit, release ultra-fast nebula arrows
	ExecutionStrike:
		'''
		Throw two galaxy hammers that strike on return
		Upon Impact, split into two sub-hammers that attach
		After attachment, sub-hammers return and strike again
		'''
}

CrimsonScythe: {
	DisplayName: Crimson Heavy Scythe
	Tooltip:
		'''
		Grants[ScarletBuff/HJScarletRework/AntiKnockbackBuff]
		Fourth swing has wider range
		Each attack inflicts[ScarletDebuff/ContinentOfJourney/DivineFireBuff]
		Causes bleed, and releases soul stones
		You can slash the soul stones to return souls
		Or, Right-click to harvest and heal
		'''
	ExecutionStrike:
		'''
		Each of the next 20 slashes grants you 2 defense on hit
		During these slashes, automatically collect souls int the stones
		Absorb one soul while returning the other to its owner
		'''
	FlavorTooltips: Beneath the blood moon, none can escape her harvest
	ExtraMechanic:
		'''
		When combined with the Front Desk Reaper set, gain the following effects:
		Increase executor damage, critical strike chance, and critical strike damage by 15%
		+30 defense, allows unlimited flight time and grants a dash ability
		'''
	ConditionMechanic:
		'''
		The Black First Sun has sealed the power of this item
		Perhaps it is time to surpass the Sun God
		'''

	KillerType: {
		OnlyCoins:
			'''
			Right-click to toggle the town NPC killing option
			Currently allows killing town NPCs, dropping only coins
			'''
		AllStuff:
			'''
			Right-click to toggle the town NPC killing option
			Currently allows killing town NPCs, dropping coins and items
			'''
		NoKilling:
			'''
			Right-click to toggle the town NPC killing option
			Currently town NPC killing is disabled
			'''
	}
}

DeathTolls: {
	DisplayName: Death Tolls
	Tooltip: Release nightmare arrow on hit
	ExecutionStrike:
		'''
		Summon a minion that mimics player actions
		Persists after switching weapons, enhances Death Tolls' attacks
		Duration consumed only when attacking
		Dashes toward the cursor before expiring
		While present, Execution Strike attaches with a delay,
		releasing shadow energy and nightmare arrow
		'''
	FlavorTooltips:
		'''
		Meditate in the death, return the
		falling stars, unleash nightmares to devour
		'''
}

TheJudgement: {
	DisplayName: The Judgement
	Tooltip: Unleashes judgement nova on hit
	ExecutionStrike:
		'''
		Summon a minion that auto-attaches to enemies
		Releases judgement nova while attached, then holy judgement on disappearance
		Duration consumed only when attacking enemies
		Max 1, and does not increase Execution Progress while present
		'''
}

DreamingLight: {
	DisplayName: Dreaming Light
	Tooltip: Summon dream hammer on hit
	ExecutionStrike:
		'''
		Summon a minion that mimics player actions
		Persists after switching weapons, enhances Dreaming Light's normal strikes 
		Duration is consumed only when attacking
		Dashes toward the player's cursor before expiring
		Does not increase Execution Progress while present
		'''
	FlavorTooltips:
		'''
		Through that boundless, silent night,
		I wrought the homecoming of a dream
		'''
}

ThePunishment: {
	DisplayName: The Punishment
	Tooltip: Unleashes punishment star on hit
	ExecutionStrike:
		'''
		Summon a minion that auto-attaches to enemies
		Releases punishment star while attached
		Duration consumed only when attacking enemies
		Max 1, and does not increase Execution Progress while present
		'''
}

SimpleHandAxe: {
	DisplayName: Simple Double-bladed Axe
	Tooltip:
		'''
		Can penetrate one enemy
		"The Beginning of Executor"
		'''
	ExecutionStrike: Ignores gravity and chases enemy on hit
}

AbyssalWorld: {
	DisplayName: Abyssal World
	Tooltip: ""
	ExecutionStrike: ""
}

Sundowner: {
	DisplayName: Sundowner
	Tooltip:
		'''
		Fires straight-flying missile and seeking streaming flames
		The projectiles cause an explosion on hit
		"No, you won't become invincible with this."
		'''
	ExecutionStrike:
		'''
		Throw a flare gun to call in an airstrike
		Hold right-click to focus the airstrike on a target
		'''
}

FrostoftheStorm: {
	DisplayName: Frost of the Storm
	Tooltip: Unleashes piercing cold winds
	ExecutionStrike:
		'''
		Performs a rapid series of slashes with alternating tempo
		Each slash sweeps a wider area and the cold wind covers a larger range
		'''
}

FrostHammer: {
	DisplayName: Frost Gravel
	Tooltip: Leaves falling ice cones along the path
	ExecutionStrike:
		'''
		Throw a snowflake that hunts down your enemy
		All subsequent ice cones will focus that target
		You can right-click on an enemy to reassign the snowflake's target
		'''
}

DualWraithStaff: {
	DisplayName: Dual-Wraith Staff
	Tooltip:
		'''
		Fires seeking wraith
		"One staff, two forms of the lingering curse."
		'''
	ExecutionStrike:
		'''
		The staff unfolds its blade and switches to javelin mode
		Javelin mode can pierce three targets
		Seeking wraith is generated only on the first hit
		Trigger Execution Strike again to switch back
		'''
}

PrunusMume: {
	DisplayName: Prunus Mume
	Tooltip:
		'''
		Toss a red plum blossom upward on hit
		The petals scatter after a short delay and can bounce off walls
		'''
	ExecutionStrike:
		'''
		Toss a red plum blossom upward for a short duration
		The blossom continuously releases rotating petals
		'''
}

StaffofFrostbite: {
	DisplayName: Staffof Frostbite
	Tooltip: ""
}

GaiaStriker: {
	DisplayName: Gaia Striker
	Tooltip: After a delay, bursts into bloody missiles
	ExecutionStrike:
		'''
		The Gaia Striker bursts open and transforms into a minion
		Press the Interact key to switch between Staff mode and Minion mode
		Minion mode automatically attacks nearby enemies
		Staff mode releases a crimson ray, which can be enhanced by takes up normal attack
		In Staff mode, each attack restores a small amount of duration to the minion
		When duration is exhausted, it bursts and Heals you
		Hold right-click to burst it early, gaining healing and refunding Execution Progress
		'''
	FlavorTooltips: The most brutal aspect of Mother Earth

	Conditions: {
		FirstTime: Before first crafting and not in multiplayer
		SecondTime: After first using the Gaia Chest, or while in multiplayer
	}
}

Frostlight: {
	DisplayName: Frostlight
	Tooltip: Fires swift frost flames that rapidly follow the cursor
	ExecutionStrike:
		'''
		Rotate the torch forward, unleashing frost fire like a flamethrower
		Trigger Execution Strike again to switch back to the first form
		'''
}

PureYinyo: {
	DisplayName: Pure Yin-Yang
	Tooltip:
		'''
		Alternates throwing the Yin and Yang Hammers
		The Yin inflicts[ScarletDebuff/Terraria/Ichor] and[ScarletDebuff/Terraria/CursedInferno], bursts out dark shards
		The Yang leaves behind erratic light shards along its path
		'''
	ExecutionStrike:
		'''
		Locks onto the enemy nearest to the cursor, attacking them
		After the attack ends, it bounces off the enemy and bursts out a large number of shards
		'''
}

LavaFlow: {
	DisplayName: Lava Flow
	Tooltip:
		'''
		Explodes on hit
		"Old things reborn"
		'''
	ExecutionStrike:
		'''
		Sticks to the enemy on hit, dealing continuous damage
		On subsequent strikes, fireballs are launched upward from the enemy
		'''
}

StarofHope: {
	DisplayName: Star of Hope
	Tooltip:
		'''
		A shining star falls toward the cursor
		Support Effect:[ScarletBuff/HJScarletRework/StarofHoperBuff]
		"A story of love and hope"
		'''
	ExecutionStrike:
		'''
		Grants the Support Effect for 60 seconds
		All Executor weapons will summon shining stars on use
		These stars add Execution Progress to the currently held weapon
		'''
}

BoneSlap: {
	DisplayName: Bone Slap
	Tooltip:
		'''
		Ignores the defense of the first enemy hit
		Launches a shower of tiny bone shards upon hitting an enemy
		This weapon always triggers Execution Strike automatically
		"You! Can't! Even! Use a search engine"
		'''
	ExecutionStrike:
		'''
		Generates more bone shards on hit, which linger on the field
		Grants the "Slap Master" effect on hit
		While under Slap Master, all auxiliary Executor weapons ignore defense and ignore penetration damage reduction
		'''
}

StreamingProtocol: {
	DisplayName: Streaming Protocol
	Tooltip:
		'''
		Sends a spam email to the target On Hit
		The spam email attempts to strike the enemy multiple times
		This weapon always triggers Execution Strike automatically
		"Based on HTTPS"
		'''
	ExecutionStrike:
		'''
		On hit, sends a red spam email that explodes and spawns more spam emails
		Grants the "High-Score Stream" effect on hit
		While under High-Score Stream:
		- Streaming Protocol hits add Execution Progress to other auxiliary weapons
		- Other auxiliary weapons spawn spam emails and red spam emails on hit
		'''
}

AngryBomb: {
	DisplayName: Angry Bomb
	Tooltip: Throws a bomb that locks onto the nearest target
	ExecutionStrike:
		'''
		The bomb becomes even angrier
		Has a wider search range and repairs itself multiple times
		'''
}

TearEye: {
	DisplayName: Cthulhu's Tear
	Tooltip:
		'''
		A whip with slower attack speed but lower damage falloff
		Support Effect:[ScarletBuff/HJScarletRework/TearEyeBuff]
		'''
	ExecutionStrike:
		'''
		Grants the Support Effect for 60 seconds
		Executor weapon hits grant 5%/10%/15% damage reduction
		'''
}

ContainedBlast: {
	DisplayName: Contained Blast
	Tooltip:
		'''
		Fires a shock round and a sticky round in quick succession
		The shock round pierces multiple enemies
		The sticky round attaches to an enemy
		Each enemy can have only one sticky round attached at a time
		'''
	ExecutionStrike:
		'''
		Detonates all sticky rounds on the field, granting effects based on the counts:
		Increases weapno's damage independently, up to 35%
		Increases weapon's attack speed and guarranted critical strike
		'''
	FlavorTooltip: Put a lid on it.
}

EndlessWar: {
	DisplayName: Endless War
	Tooltip: On Hit, summons punishing lightning
	ExecutionStrike:
		'''
		Transforms into a special Minion Hammer on hit
		The suspended Minion Hammer automatically attacks nearby enemies and calls down multiple lightning strikes around itself
		While the Minion Hammer is active, pressing the Interact key again—or when it is about to expire—performs three wide-area heavy strikes in the direction of your attack
		These heavy strikes ignore defense, release lightning during the swing, and stun enemies on each hit
		'''
	FlavorTooltips: ""
}

SplendidofTerra: {
	DisplayName: Splendid Terra
	Tooltip: After a delay, releases life missiles
	ExecutionStrike:
		'''
		Transforms into a special Minion Hammer on hit
		While active, press the Interact key to switch between Staff mode and Minion mode
		In Minion mode, it automatically attacks nearby enemies
		In Staff mode, it releases a life ray; while holding the Splendid Terra, its normal attack is replaced to enhance the ray
		In Staff mode, each attack with the held Splendid Terra restores a small amount of the Minion Hammer's duration
		When duration runs out, the Splendid Terra disperses, healing you
		You may also hold right-click for a moment to prematurely disperse the Minion Hammer, granting more healing and refunding Execution Progress
		'''
	FlavorTooltips: —An existence that belongs to Pan-Human History—
}

ASMD: {
	DisplayName: A.S.M.D.
	Tooltip:
		'''
		Fires an eletronic frost-fire shell that explodes
		Attacks inflict[ScarletDebuff/Terraria/Frostburn2]
		'''
	ExecutionStrike:
		'''
		Implanted into the victim and explode multiple times
		Bursts out multiple ice chunks on final explosion, lingering on the field
		Subsequent shell hits will cause one ice chunk to chase that enemy
		'''
	AlterDisplayName: ""
}

SickleAndTorch: {
	DisplayName: Slash and Burn
	Tooltip:
		'''
		Inflict[ScarletDebuff/Terraria/Oiled] on scythe hit
		Inflict[ScarletDebuff/Terraria/OnFire3] on torch hit
		'''
	ExecutionStrike:
		'''
		Sickle attacks have stronger knockback
		Torch direct hits launch gravity-affected fireballs
		'''
}

PureDagger: {
	DisplayName: Pure White Dagger
	Tooltip: Grants[ScarletBuff/HJScarletRework/AntiKnockbackBuff]on hit
	ExecutionStrike:
		'''
		Increases your defense by 6
		Increases attack speed and Spawn pure stars on hit
		'''
}

Monocle: {
	DisplayName: Monocle
	Tooltip:
		'''
		High-speed, precise bullets pierce multiple enemies
		Damage increases with each enemy pierced
		'''
	ExecutionStrike:
		'''
		Fires a nearly instantaneous high-speed piercing bullet
		The bullet will try to ricochets to the nearest target
		Infinite piercing, always critically strikes
		Critical strike chance is converted to critical strike damage at a 1:1 ratio
		'''
	FlavorTooltip: One is enough.
}

ArcticGuanDao: {
	DisplayName: Arctic Guan Dao
	Tooltip:
		'''
		Swing to knock back nearby enemies
		Attacks always inflict[ScarletDebuff/Terraria/Frostburn]
		'''
	ExecutionStrike:
		'''
		Sends a snow cloud toward the cursor position
		The cloud lingers on the field and drops icicles
		'''
}

ConferenceCall: {
	DisplayName: Conference Call
	Tooltip:
		'''
		Fires 5 bullets at once
		Each bullet splits into two split shots after while, or hitting an enemy
		Split shots bounce off walls
		'''
	ExecutionStrike:
		'''
		Empowers attacks for the next 5 seconds
		All bullets bounce off walls and can pierce one enemy
		'''
	FlavorTooltip: Let's just ping everyone all at once.
}

GhostKnife: {
	DisplayName: Ghost Dagger
	Tooltip: Throws a knife that pierces multiple enemies and pursues on hit
	ExecutionStrike:
		'''
		Grants Ghost Mark for 60 seconds to enhance executor attacks
		Executor critical strike chance is increased by 10%
		Fires Ghost Daggers during attacks, which do not pursue on hit
		'''
}

DesertKnife: {
	DisplayName: Desert Knife
	Tooltip: Can pierce up to 3 enemies
	ExecutionStrike:
		'''
		Grants Desert Mark for 120 seconds to enhance executor attacks
		Most Executor weapons gain +2 piercing
		Weapons that do not pierce are unaffected
		'''
}

DungeonKnife: {
	DisplayName: Steel Dagger
	Tooltip: Bounces toward the nearest enemy when hitting a wall
	ExecutionStrike:
		'''
		Grants Dungeon Mark for 30 seconds to enhance all executor attacks
		Executor defense is increased by 8
		Damage taken from Dungeon enemies is reduced by 85%
		'''
}

FishronKnife: {
	DisplayName: Duke's Fang
	Tooltip: Spawns seeking bubbles on hit
	ExecutionStrike:
		'''
		Grants Duke Mark for 60 seconds to enhance all executor attacks
		Executor damage is increased by 20%
		Also allows you to swim freely in water
		'''
}

GrassKnife: {
	DisplayName: Grass Knife
	Tooltip:
		'''
		Inflicts a special Jungle Venom
		Jungle Venom deals 25/50/100 damage over time
		Which is scaling with game progression
		'''
	ExecutionStrike:
		'''
		Grants Jungle Mark for 60 seconds to enhance all executor attacks
		Executor applies Jungle Venom that stacks up to 10 times
		Grass Knife direct hits trigger the damage on targets with over 3 Jungle Venom stacks
		'''
}

MoltenKnife: {
	DisplayName: Molten Throwing Knife
	Tooltip: Explodes on hit
	ExecutionStrike:
		'''
		Grants Molten Mark for 60 seconds to enhance all executor attacks
		Executor adds molten explosion, deals 2.75x damage and cannot crit
		'''
}

TheSevenStar: {
	DisplayName: Seven Stars
	Tooltip:
		'''
		Fires a star toward the cursor
		Lights up the Big Dipper behind you
		'''
	ExecutionStrike:
		'''
		The seven bright stars fire a beam toward the cursor
		The beam pierces multiple enemies
		'''
}

StormSaber: {
	DisplayName: Storm Saber
	Tooltip:
		'''
		Destroys enemies
		A heteromorphic product crudely reassembled from a broken blade still holding residual storm power
		Though not authentic, it still wields some of its former might against giants
		'''
	ExecutionStrike: Significantly increases attack speed
}

TheGreatDipper: {
	DisplayName: Polaris
	Tooltip:
		'''
		Fires two stars toward the cursor
		Lights up the Big Dipper behind you
		Execution is manual in this mode
		'''
	ExecutionStrike:
		'''
		Each swing fires seven seeking stars and lights up the Big Dipper behind you.
		When fully lit, triggers Execution Strike, unfolding a galaxy at the cursor
		Execution is automatic in this mode
		'''
	Special: ""
}

BambooBow: {
	DisplayName: Agile Bamboo Bow
	Tooltip: ""
	ExecutionStrike:
		'''
		Enhances the next 12 attacks
		Increases attack speed, arrow speed, and allows arrows to pierce
		'''
}

BambooSword: {
	DisplayName: Bamboo Practice Sword
	Tooltip: Briefly stops and knocks back small enemies
	ExecutionStrike:
		'''
		Throws the bamboo sword that stops on the first enemy hit
		The sword lingers briefly, spinning and striking nearby enemies
		Each strike always stops the enemy
		'''
}

ClimaticHawstring: {
	DisplayName: Climatic Bowstring
	Tooltip:
		'''
		Two small flying rods descend from the sky, assist in attacking enemies
		"The sky's rod as the bow, and the breath of the climate as the string"
		'''
	ExecutionStrike: Fires thermal lasers continuously for the next 5 seconds
}

WeHaveBookshelf: {
	DisplayName: We Have a Bookshelf
	Tooltip:
		'''
		Stuns enemies
		"We have a big bookshelf!"
		'''
	ExecutionStrike: The next 15 swings each release more books
}

Stella: {
	DisplayName: Stella
	Tooltip: ""
	ExecutionStrike: ""
}

Headsplosion: {
	DisplayName: Headsplosion
	Tooltip:
		'''
		Your attacks always critically strike, and fired bullets always cause explosions
		Explosions always eject multiple small ricochets that cause secondary explosions
		Small explosive ricochets inflict[ScarletDebuff/Terraria/Ichor]
		'''
	ExecutionStrike:
		'''
		Adds more small ricochets
		Small ricochet explosions add two split ricochets
		'''
	FlavorTooltip: That happens all the time.
}

Moonfire: {
	DisplayName: Moonfire
	Tooltip:
		'''
		An extremely precise revolver
		Press the Interact key at any time to perform Execution Strike
		'''
	ExecutionStrike:
		'''
		Immediately fires an enhanced bullet that ricochets between multiple enemies
		The number of ricochets are based on the Execution Progess
		'''
	FlavorTooltip: Meet your destiny.
}

Reflux: {
	DisplayName: Reflux
	Tooltip: Fires spread bullets inflicting [ScarletDebuff/Terraria/CursedInferno]
	ExecutionStrike:
		'''
		Fires bullets with more pierces
		On first hit, bullets generate a chain that links two nearby targets
		A target can be linked by up to five chains
		'''
	FlavorTooltip: That's gonna burn.
}

TheGarcia: {
	DisplayName: The Garcia
	Tooltip: A shotgun with a faster fire rate
	ExecutionStrike: Fires more bullets with less spread
	FlavorTooltip: Rooty-tooty, pointy-shooty.
}

CrescentRose: {
	DisplayName: Crescent Rose
	Tooltip: ""
	ExecutionStrike: ""
	FlavorTooltips: ""
}

CobaltYoyo: {
	DisplayName: Cobalt Yoyo
	Tooltip: Causes a explosion on hit
	ExecutionStrike:
		'''
		Cause multiple explosions on the hit enemy
		Has high armor penetration
		'''
}

TitaniumBattleShovel: {
	DisplayName: Titanium Battle Shovel
	Tooltip: Stuns enemies for a short time on hit
	ExecutionStrike:
		'''
		Enhances attacks for the next 10 seconds
		Increases attack range and number of hit checks
		'''
}

MythrilStaff: {
	DisplayName: Mythril Staff
	Tooltip: ""
}

TheCompanion: {
	DisplayName: The Companion
	Tooltip:
		'''
		Inflicts [ScarletDebuff/Terraria/Oiled] on non-critical hits
		Inflicts [ScarletDebuff/Terraria/OnFire3] on critical hits
		'''
	ExecutionStrike:
		'''
		Fires a bullet that always critically strikes
		On hit, applies Hellfire to a large area of enemies
		No target limit
		'''
	FlavorTooltip: You can't take the sky from me.
}
