ClimaticHawstring: {
	DisplayName: Climatic Hawstring
	Tooltip:
		'''
		When landing a certain number of hits on enemies, continuously fire thermal lasers for the next 5 seconds
		On attack, two small Flying Rod Minions assist in the attack
		"With the sky's rod as the bow, and the breath of the climate as the string"
		'''
}

BambooRocket: {
	DisplayName: Bamboo Rocket
	Tooltip: Fires homing bamboo
}

TerraFlamethrower: {
	DisplayName: Terra Flamethrower
	Tooltip:
		'''
		Bathe your enemies in the dazzling light of Terra
		Press right-click to throw a phlogiston grenade that explodes on hit, applying Terra Phlogiston to enemies
		The Terra Phlogiston effect causes enemies to constantly drip Terra Essence from their bodies, dealing damage equal to 100% of the enemy's contact damage
		Terra Essence does not damage enemies affected by Terra Phlogiston
		80% chance to not consume gel
		'''
}

BlazingSun: {
	DisplayName: Blazing Sun
	Tooltip:
		'''
		Rapidly fires blazing arrows in succession and summons two miniature suns to fight for you
		All attacks can pass through walls
		'''
}
