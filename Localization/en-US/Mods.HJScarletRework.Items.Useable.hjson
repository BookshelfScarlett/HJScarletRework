DescriptionPaper: {
	DisplayName: Description Paper
	Tooltip:
		'''
		This note is just to let you know that the Lostbelt Journey mod has added a new class: the Executor.
		However, since the mod currently lacks sufficient armor sprites, the mod provides Executor-modified versions of the vanilla armors listed below.
		[i:RainHat][i:RainCoat]Raincoat Set – crafted with [i:Silk]Silk
		[i:CowboyHat][i:CowboyJacket][i:CowboyPants] Cowboy Set – crafted with [i:ShadowScale] Shadow Scale / [i:TissueSample] Tissue Sample and [i:Silk] Silk
		[i:FloretProtectorHelmet][i:FloretProtectorChestplate][i:FloretProtectorLegs]Floret Protector Set – can be transformed after defeating The Lifebringer
		[i:MonkBrows][i:MonkShirt][i:MonkPants]Monk Armor / [i:MonkAltHead][i:MonkAltShirt][i:MonkAltPants]Shinobi Armor – also receive Executor versions
		All of the reworked vanity sets mentioned above gain brand new effects and set bonuses.
		Also, you can hold Left Alt to view the list of developers and support staff who contributed to this mod
		'''
	ThanksList:
		'''
		[c/CC0340:Lead Developers:]
		ScarletShelf - Lead Programmer
		Inoljw, 名字, Freya - Artists
		-
		[c/BAEE1B:Support Staff:]
		Sakuraba Ichika, Demon Lilies, Plantare
		Serrat Antler, 南鸢北笙, 梦山之主, Yilyn, TIM
		[c/B19CD9:Testers:]
		Endtimeless, Woodi Stigma, 妩媚の5妹儿, Shizuku, 步出夏门行
		[c/FFC0CB:Donators:]
		巴雷难破长夜, 冰川咲, 银九, 曦, 丰川祥子, 苏利, 池堂爱吃糖, 咕咕叶子
		[c/AACCCC:Many thanks to everyone for making this mod a success and pushing it forward]
		'''
}

PurePrismFate: {
	DisplayName: Pure Prism
	Tooltip:
		'''
		While holding, press the Interact key on a crafting material in your inventory to duplicate it by consuming Prisms.
		Up to 100 copies can be duplicated at once, and each duplication consumes 3 Prisms.
		"A more refined Mana Crystal."
		'''
}

UnregisteredSpiritOrigin: {
	DisplayName: Unregistered Spirit Origin
	Tooltip:
		'''
		While held, press the Interact key on a weapon/accessory/armor/treasure bag in your inventory to duplicate it by consuming.
		The Unregistered Spirit Origin itself cannot be duplicated.
		"The overflowing remnants of a Spirit Origin."
		'''
}

