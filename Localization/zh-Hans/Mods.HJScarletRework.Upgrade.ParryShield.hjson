GeneralText: 可用于强化格挡盾，按住Alt查看

Types: {
	CobaltShield:
		'''
		增强格挡的效力
		格挡成功后一定时间内使队伍免疫击退
		'''
	ObsidianShield:
		'''
		增强格挡的效力
		格挡命中时迸发大量的弹跳火球
		格挡成功后一定时间内使队伍免疫击退
		'''
	AnkhShield:
		'''
		增强格挡的效力
		格挡成功后使队伍免疫击退和大部分减益一定时间
		格挡命中时迸发大量的弹跳火球
		你会对格挡的敌人随机施加5种减益效果
		'''
	EoCShield: ""
	FrozenShield:
		'''
		增强格挡的效力
		格挡成功后，队伍30秒内可以减少三次来犯攻击伤害的85%
		同时，为你队伍内一名低于25%血量的玩家提供30%的伤害减免
		'''
	HeroShield:
		'''
		增强格挡的效力
		格挡成功后，队伍获得25%伤害和25点防御力加成
		格挡成功后，为你或队伍内一名低于25%血量的玩家提供治疗
		'''
	SquireShield: ""
	PaladinsShield:
		'''
		增强格挡的效力
		格挡成功后，随机复活队伍内的一名死亡玩家到你身旁
		若队伍内不存在死亡的玩家，则为血量最低的一名玩家恢复100%生命值
		若处于单人游戏下，则为自己提供25%的治疗
		'''
	MasterSheild: ""
}
