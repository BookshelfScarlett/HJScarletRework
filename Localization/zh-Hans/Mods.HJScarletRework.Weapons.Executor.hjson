Exsanguination: {
	DisplayName: 放血疗法
	Tooltip:
		'''
		以超高的频率发射超高速的子弹流
		射出的所有子弹都会造成真实伤害
		'''
	ExecutionStrike:
		'''
		启动后彻底粉碎被命中的敌人的护盾
		在接下来的一段时间内对该名敌人造成武器面板的3倍伤害
		'''
}

MantleLayer: {
	DisplayName: 地幔
	Tooltip:
		'''
		命中时，从敌人身上弹起，而后进行一次重击
		在返程的时候不会发起这个效果
		'''
	ExecutionStrike:
		'''
		地幔将会尝试在你的敌人上挂载，持续造成伤害
		在造成固定频次的伤害后，地幔将会尝试进行两次力度更大的重击
		'''
}

DungeonBreaker: {
	DisplayName: 地牢破坏者
	Tooltip:
		'''
		命中时，造成一次范围伤害的冲击
		会直接破坏地牢内的危险类物块
		开启困难模式后，可以直接破坏地牢方块
		'''
	ExecutionStrike:
		'''
		高速掷出且允许无限穿透
		撞击墙体时砸入墙内，并强制震开附近所有小型敌人
		其将会不断向后释放可以在墙体上反弹的小型水箭
		'''
}

FleshGrinder: {
	DisplayName: 碾肉机
	Tooltip: 命中时，碾压敌人的血肉使其爆开
	ExecutionStrike:
		'''
		碾肉机会尝试搜索多名敌人
		每检索到一名可用敌人时，碾肉机都会尝试攻击这名敌人6次
		最大可攻击4名敌人
		'''
}

JungleMadness: {
	DisplayName: 丛林狂怒
	Tooltip: 命中时，追加短暂飞行的穿墙树叶
	ExecutionStrike:
		'''
		返程后回击，并挂载在敌人上造成12次伤害
		每次造成伤害时都会追加穿墙的旋转树叶
		'''
}

DreamlessNight: {
	DisplayName: 无梦之夜
	Tooltip: 命中时，释放梦境之花
	ExecutionStrike:
		'''
		命中时，返程变为仆从锤
		悬挂的仆从锤将模拟玩家行动，且不会在切换武器后消失，并强化无梦之锤的普通攻击
		只有攻击时才会消耗仆从锤的在场时间，且在场时间殆尽前将会朝玩家指针位置冲刺
		场上最多只存在一把仆从锤，且仆从锤在场时不会增加处决叠层次数
		'''
	FlavorTooltips: 「-我于那漫漫长夜中，思念着梦的存在-」
}

TheDefiler: {
	DisplayName: 玷污者
	Tooltip: 命中时，感染敌人的血肉使其糜烂
	ExecutionStrike:
		'''
		玷污者会尝试搜索多名敌人
		每检索到一名可用敌人时，玷污者都会尝试攻击这名敌人4次
		最大可攻击7名敌人
		'''
}

AetherfireSmasher: {
	DisplayName: 天炎破
	Tooltip:
		'''
		掷出后飞越至附近可用的敌人
		成功命中时追加追踪火球
		'''
	ExecutionStrike:
		'''
		直接掷出一个重击锤，在一定时间后冲向距离最近的敌人
		重击锤会持续挂载在敌人身上并持续释放火柱
		'''
}

BinaryStars: {
	DisplayName: 双子星
	Tooltip: 命中时，追击迅捷的星云之矢
	ExecutionStrike:
		'''
		同时掷出两把星系之锤，返程时回击敌人
		撞击敌人后分裂成两个子锤，并挂载在敌人上造成持续伤害
		挂载结束后，子锤将会返程至玩家手中并再进行一次回击
		'''
}

CrimsonScythe: {
	DisplayName: 猩红重镰
	Tooltip:
		'''
		持续劈砍下，第四轮劈砍提升攻击范围
		每次命中时都会使你免疫击退，并对敌人放血，释放其中的灵魂石
		你可以通过劈砍的方式，将灵魂石中的灵魂打回原主
		也可以通过按下右键以收割灵魂石，恢复你的生命
		'''
	ExecutionStrike:
		'''
		接下来的20次劈砍中每次命中时，都会为你增加2点防御力
		劈砍过程中自动将场上的灵魂石进行回收
		吸收一份灵魂的同时将另一份灵魂打回原主
		'''
	FlavorTooltips: 「-红月之下，无人能逃过她的收割-」
	ExtraMechanic:
		'''
		与前台死神套装一同组合时，获得如下效果
		增加15%代行者伤害、暴击概率与暴击伤害和30点防御力
		允许无限飞行时间，获得冲刺能力
		'''
	ConditionMechanic:
		'''
		黑色的第一太阳封存了这件物品的力量
		或许应该去尝试超越太阳之神了
		'''
}

DeathTolls: {
	DisplayName: 死亡丧钟
	Tooltip: 命中时，引梦魇之箭从天而降
	ExecutionStrike:
		'''
		回击成功时返程成为仆从锤
		仆从锤在场时，处决攻击将会使死亡锤延迟挂载，并释放暗影魔能与梦魇之箭
		悬挂的仆从锤将模拟玩家行动，且不会在切换武器后消失，并强化死亡锤的普通攻击
		只有攻击时才会消耗仆从锤的在场时间，且在场时间殆尽前将会朝玩家指针位置冲刺
		场上最多只存在一个挂载锤与一个仆从锤
		'''
	FlavorTooltips: 「-于丧钟中冥思，召陨星归位，释梦魇噬敌-」
}

TheJudgement: {
	DisplayName: 圣神断罪
	Tooltip: 命中时，迸发断罪之星
	ExecutionStrike:
		'''
		圣神断罪将在返程后回击，并挂载在敌人上造成持续伤害
		挂载时持续释放断罪之星，并在消失后追加神圣射线
		挂载锤只有在攻击敌人时才会消耗在场时间
		最多只存在一把挂载锤，且挂载锤在场时不会增加处决叠层次数
		'''
}

DreamingLight: {
	DisplayName: 铸梦之光
	Tooltip: 命中时，召唤梦境之锤
	ExecutionStrike:
		'''
		命中时，返程变为仆从锤
		悬挂的仆从锤将模拟玩家行动，且不会在切换武器后消失，并强化铸梦之光的普通攻击
		只有攻击时才会消耗仆从锤的在场时间，且在场时间殆尽前将会朝玩家指针位置冲刺
		场上最多只存在一把仆从锤，且仆从锤在场时不会增加处决叠层次数
		'''
	FlavorTooltips: 「-我于那长眠之夜中，铸就了梦的归来-」
}

ThePunishment: {
	DisplayName: 神明裁决
	Tooltip: 命中时，追击裁决新星
	ExecutionStrike:
		'''
		神明裁决将在返程后回击，挂载于敌人上持续释放裁决新星
		挂载锤只有在攻击敌人时才会消耗在场时间
		最多只存在一把挂载锤，且挂载锤在场时不会增加处决叠层次数
		'''
}

SimpleHandAxe: {
	DisplayName: 简易双刃斧
	Tooltip:
		'''
		可穿透一名敌人
		“代行者的起点”
		'''
	ExecutionStrike: 无视重力，并在命中时追杀这名敌人
}

AbyssalWorld: {
	// DisplayName: Abyssal World
	// Tooltip: ""
	// ExecutionStrike: ""
}

Sundowner: {
	DisplayName: 焚风
	Tooltip:
		'''
		同时发射直线飞行的炮弹与追踪敌人的流火
		炮弹在命中时会造成一次爆炸
		"不，你用这个不会变得无敌"
		'''
	ExecutionStrike:
		'''
		投掷一个信号枪以呼叫空袭
		你可以按住右键使空袭集中目标
		'''
}

FrostoftheStorm: {
	DisplayName: 寒霜风暴
	Tooltip: 挥舞时生成无限穿透的寒风
	ExecutionStrike:
		'''
		将会以快慢的节奏进行连续多下的挥砍
		挥砍横扫的面积更大，寒风的覆盖范围也更广
		'''
}

FrostHammer: {
	DisplayName: 冰砾
	Tooltip: 沿途滞留下坠的冰锥
	ExecutionStrike:
		'''
		掷出一个雪花，追杀你的敌人
		雪花命中敌人时，接下来释放的冰锥都会集中攻击这个目标
		你可以对敌人右键从而为雪花重新锁定一个目标
		'''
}

DualWraithStaff: {
	DisplayName: 双魂魔杖
	Tooltip:
		'''
		发射不可穿墙的追踪幽魂
		“幽魂之咒，一杖双形”
		'''
	ExecutionStrike:
		'''
		魔杖将会展开刀刃，切换为投矛形态
		投矛形态下允许穿越墙体，穿透3名敌人，只有首次命中时才会生成追踪的幽魂射弹
		满足处决攻击发起条件时，可通过再次按下 互动键 以切换回第一形态
		'''
}

PrunusMume: {
	DisplayName: 红梅
	Tooltip:
		'''
		命中时往上放抛掷一朵红梅花
		花瓣将会在一定时间后分散开来，且可以在墙体上反弹一次
		'''
	ExecutionStrike:
		'''
		原地向上抛掷一朵红梅花，这朵红梅花会持续停留在场上一段时间
		同时，红梅花将会尝试持续不断地释放旋转的花瓣
		'''
}

StaffofFrostbite: {
	// DisplayName: Staffof Frostbite
	// Tooltip: ""
}

GaiaStriker: {
	DisplayName: 盖亚重锤
	Tooltip: 掷出一定时间后，爆裂血腥飞弹
	ExecutionStrike:
		'''
		盖亚重锤将在命中后变化为特殊性质仆从锤
		仆从锤在场时，可通过按下互动键以在射线模式与自动模式切换
		自动模式下仆从锤会自动攻击附近的敌人
		射线模式下将会释放猩红射线，手持盖亚重锤时占用其普通攻击以增强射线功能
		射线模式下，手持盖亚重锤每次进行攻击时，会为仆从锤回复少量存续时间
		存续时间殆尽时，盖亚重锤将会爆裂，为你提供治疗
		你也可以通过长按鼠标右键一定时刻后，提前使仆从锤爆裂，获得更多的治疗，返还处决叠层
		'''
	FlavorTooltips: 「-大地之母最为残暴的一面-」

	Conditions: {
		FirstTime: 首次合成前且不在多人游戏内
		SecondTime: 首次使用盖亚宝箱后或正处于多人游戏内
	}
}

Frostlight: {
	DisplayName: 寒霜火炬
	Tooltip: 快速发射迅捷追随鼠标位置的寒霜流火
	ExecutionStrike:
		'''
		旋转火炬指向前方，以喷火器的形式倾泻寒霜之火
		满足处决攻击发起条件时，可通过再次按下 互动键 以切换回第一形态
		'''
}

PureYinyo: {
	DisplayName: 至纯阴阳
	Tooltip:
		'''
		交替投掷阴阳双锤
		太阴之锤命中时同时造成咒火与灵液，并迸发黑暗碎块
		太阳之锤沿途生成轨迹飘忽不定的光明碎块
		'''
	ExecutionStrike:
		'''
		至纯阴阳掷出后锁定距离玩家指针的敌人进行攻击
		攻击结束时，将会从敌人身上弹开，并迸发大量的碎块
		'''
}

LavaFlow: {
	DisplayName: 熔岩流
	Tooltip:
		'''
		命中时爆炸
		“旧物重生”
		'''
	ExecutionStrike:
		'''
		命中时扎在敌人身上造成持续伤害
		后续进行追击时，都会从敌人身上向上抛射火球
		'''
}

StarofHope: {
	DisplayName: 希望之星
	Tooltip:
		'''
		挥舞时，一枚闪耀之星朝向指针位置坠落
		“爱与希望的故事”
		'''
	ExecutionStrike:
		'''
		接下来的60秒内，获得“希望之星”的Buff类标记
		希望之星Buff图标持续期间，所有代行者武器都会在使用时天降闪耀之星
		该闪耀之星在命中敌人时将允许进行玩家手持武器的处决叠层
		'''
}

BoneSlap: {
	DisplayName: 骨掌
	Tooltip:
		'''
		无视首次命中的敌人的防御力
		拍中敌人时抛射大量细碎的小骨头
		该武器必定自动处决
		"你！连！搜索引擎！都不会用吗！"
		'''
	ExecutionStrike:
		'''
		在拍中敌人时会生成更多小骨头，且骨头将会滞留在场上
		命中敌人时使你获得“耳光侠”效果
		耳光侠效果期间，所有辅助道具类型的代行者武器无视防御力，无视穿透伤害减免
		'''
}

StreamingProtocol: {
	DisplayName: 推流协议
	Tooltip:
		'''
		命中时向对方发送一封骚扰邮件
		骚扰邮件会尝试多次攻击被命中的敌人
		该武器必定自动处决
		”基于HTTPS”
		'''
	ExecutionStrike:
		'''
		命中时发送一枚红色垃圾邮件，命中时爆炸并追加更多骚扰邮件
		命中敌人时使你获得“高分直播”效果
		在高分直播效果期间
		推流协议命中时，会增加其余辅助道具的处决叠层
		其余辅助道具则在命中时追加骚扰邮件与红色垃圾邮件
		'''
}

AngryBomb: {
	DisplayName: 愤怒炸弹
	Tooltip: 掷出一定时间后锁定距离最近的目标
	ExecutionStrike:
		'''
		这枚炸弹将变得更加愤怒
		拥有更广的索敌范围，且在命中后会多次修复自身进行回击
		'''
}

TearEye: {
	DisplayName: 克苏鲁的眼泪
	Tooltip: 攻击速度更慢，但是伤害衰减力度更低的鞭子
	ExecutionStrike:
		'''
		接下来的60秒内，获得“克苏鲁之泪”的Buff类标记
		克苏鲁之泪星Buff图标持续期间，代行者武器命中时增加5%/10%/15%伤害减免
		同时，使代行者获得潮湿减益
		'''
}

ContainedBlast: {
	DisplayName: 遏制爆炸
	Tooltip:
		'''
		先后快速发射冲击弹与粘弹
		冲击弹会穿透多个敌人，粘弹会粘附在敌人上
		每个敌人最多粘附一枚粘弹
		'''
	ExecutionStrike:
		'''
		引爆场上所有粘弹，根据造成的伤害次数提供效果：
		为遏制爆炸提供独立增伤，最大50%
		增强遏制爆炸的攻击频率，并使遏制爆炸的攻击必定暴击
		接下来的时间内，冲击弹的命中都会叠加处决进程
		'''
	FlavorTooltip: 盖上盖子。
}

EndlessWar: {
	DisplayName: 无尽战争
	Tooltip: 命中时，追及惩戒闪电
	ExecutionStrike:
		'''
		无尽战争将在命中后变化为特殊性质仆从锤
		悬挂的仆从锤将自动攻击附近的敌人，同时会以其为中心在周围降下多道闪电
		仆从锤在场期间再次按下互动键，或即将消失时，将朝向你攻击的方向进行三次大范围的重击
		重击无视防御力，挥击过程中也会持续释放闪电，且每次命中时都会震慑敌人
		'''
	FlavorTooltips: ""
}

SplendidofTerra: {
	DisplayName: 璀璨大地
	Tooltip: 掷出一定时间后，释放生命飞弹
	ExecutionStrike:
		'''
		璀璨大地将在命中后变化为特殊性质仆从锤
		仆从锤在场时，可通过按下互动键以在射线模式与自动模式切换
		自动模式下仆从锤会自动攻击附近的敌人
		射线模式下将会释放生命光线，手持璀璨大地时占用其普通攻击以增强射线功能
		射线模式下，手持璀璨大地每次进行攻击时，会为仆从锤回复少量存续时间
		存续时间殆尽时，璀璨大地将会消散，为你提供治疗
		你也可以通过长按鼠标右键一定时刻后，提前使仆从锤消散，获得更多的治疗，返还处决叠层
		'''
	FlavorTooltips: 「-本属于泛人类史的存在-」
}

ASMD: {
	DisplayName: A.S.M.D
	Tooltip: 发射一枚命中时造成爆炸的电磁霜炎炮弹
	ExecutionStrike:
		'''
		植入受害者体内，造成多段爆炸伤害
		最后一发爆炸将从其体内迸裂出多个冰块，滞留在场上一段时间
		接下来的炮弹命中时，都会使一枚冰块追击该名敌人，并为您提供叠加处决进程
		'''
}

SickleAndTorch: {
	DisplayName: 刀耕火种
	Tooltip: 第三下攻击时投掷火把
	ExecutionStrike:
		'''
		镰刀攻击的击退力更强，并在命中时增强火焰的烧伤力
		火把直接命中时迸发受重力影响的火球
		'''
}

PureDagger: {
	DisplayName: 洁净白刃
	Tooltip: 刀刃命中时使你[i:CobaltShield]免疫击退
	ExecutionStrike:
		'''
		加快劈砍速度，劈砍命中时会追加纯净白星
		同时，增加6点防御力
		'''
}

Monocle: {
	DisplayName: 单片镜
	Tooltip:
		'''
		高速精准的子弹贯穿多名敌人
		贯穿的敌人越多，伤害越高
		'''
	ExecutionStrike:
		'''
		发射一枚几乎瞬发命中的高速穿透子弹
		子弹在撞击墙体或一定时间后转火最近的目标
